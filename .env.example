# Application mode & security
# Set DEBUG=false in production. When DEBUG=false, both SECRET_KEY and ADMIN_PASSWORD must be provided.
DEBUG=true
SECRET_KEY=your_secure_secret_key_here
ADMIN_PASSWORD=your_admin_password_here

# Database configurations
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=try-fit

# Database SSL configuration
# Set to false for local MySQL installations without SSL.
# Set to true for production/cloud environments (e.g., Aiven, TiDB) where SSL is required.
DB_SSL=false

# Web Server configurations
PORT=8000

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# OTP Delivery settings
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
RESEND_API_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TRY-FIT
EMAIL_PROVIDER=resend
SENDER_EMAIL=TRY-FIT <onboarding@resend.dev>
