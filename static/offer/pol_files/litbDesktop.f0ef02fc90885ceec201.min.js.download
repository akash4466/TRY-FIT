led for searching. Please try again at a later time."},"kfw_mwr_redirect_option":{"note":"KFW to Manga Web Reader Redirect Button String","value":"Enable Comics Beta"},"pagination_next_page":{"note":"KR paginated view next page button text","value":"Next page"},"pagination_previous_page":{"note":"KR paginated view previous page button text","value":"Previous page"},"dictionary_result_origin":{"value":"Origin"},"dictionary_result_notes":{"value":"Notes"},"dictionary_result_usage":{"value":"Usage"},"dictionary_result_derivatives":{"value":"Derivatives"},"dictionary_result_ipa":{"value":"Ipa"},"dictionary_result_related_words":{"value":"Related words"},"dictionary_result_morphology":{"value":"Morphology"},"dictionary_result_phrases":{"value":"Phrases"},"page_reading_progress":{"note":"Title for the reading progress AA menu option to enable/disable showing the page in book","value":"Page in book"},"chapter_reading_progress":{"note":"Title for the reading progress AA menu option to enable/disable showing the time left until the end of the chapter","value":"Time left in chapter"},"book_reading_progress":{"note":"Title for the reading progress AA menu option to enable/disable showing the time left until the end of the book","value":"Time left in book"},"share_link":{"note":"Text on sample share button before copy","value":"Share link"},"copied_link":{"note":"Text on sample share button after copy","value":"Link copied"},"copy_link_to_share":{"note":"Text on share button before copy","value":"Copy link to share"},"kindle":{"note":"Text displayed on a button that allows to switch between kindle format and paperback format","value":"Kindle"},"paperback":{"note":"Text displayed on a button that allows to switch between kindle format and paperback format","value":"Paperback"},"kw-litb-guided-view-button":{"note":"Text displayed when hovering over the Guided View button","value":"Toggle Guided View"},"kw-litb-zoom-button":{"note":"Text displayed when hovering over the Zoom butto